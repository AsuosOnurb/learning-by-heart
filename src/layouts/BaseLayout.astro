---
import '../styles/global.css';
const { title = 'LEARNING BY HEART', description = 'A digital notebook for systems, language, and social structures.', searchable = false } = Astro.props;
const currentPath = Astro.url.pathname;
const nav = [{ label:'NOTEBOOK', href:'/' }, { label:'INDEX', href:'/archive/' }, { label:'ESSAYS', href:'/posts/' }, { label:'ABOUT', href:'/terminal/' }];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="article" /><title>{title} — LEARNING BY HEART</title><script is:inline>try { const savedTheme = localStorage.getItem('learning-by-heart-theme'); document.documentElement.dataset.theme = savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; } catch { document.documentElement.dataset.theme = 'light'; }</script></head><body>
<div class="site-shell"><header class="site-header" data-pagefind-ignore><div class="brand-row"><a class="brand" href={import.meta.env.BASE_URL}>LEARNING BY HEART</a><div class="header-actions"><button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="false">THEME: LIGHT</button><a class="search-link" href={`${import.meta.env.BASE_URL}search/`} aria-label="Search essays">⌕</a></div></div><nav class="nav" aria-label="Primary navigation">{nav.map((item) => <a href={`${import.meta.env.BASE_URL}${item.href === '/' ? '' : item.href.slice(1)}`} aria-current={currentPath === `${import.meta.env.BASE_URL}${item.href === '/' ? '' : item.href.slice(1)}` ? 'page' : undefined}>{item.label}</a>)}<span class="status" style="margin-left:auto;padding:10px 12px;">NOTEBOOK: ACTIVE</span></nav></header><main {...(!searchable ? {'data-pagefind-ignore':'all'} : {})}><slot /></main><footer class="footer" data-pagefind-ignore>LIVING NOTEBOOK // NO TRACKING // BUILT FOR LONG-FORM ATTENTION</footer></div>
<script is:inline>const themeToggle = document.querySelector('#theme-toggle'); const applyTheme = (theme) => { document.documentElement.dataset.theme = theme; themeToggle?.setAttribute('aria-pressed', String(theme === 'dark')); if (themeToggle) themeToggle.textContent = `THEME: ${theme.toUpperCase()}`; }; applyTheme(document.documentElement.dataset.theme || 'light'); themeToggle?.addEventListener('click', () => { const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; applyTheme(nextTheme); try { localStorage.setItem('learning-by-heart-theme', nextTheme); } catch {} });</script>
</body></html>
