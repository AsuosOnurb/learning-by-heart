---
import '../styles/global.css';
const { title = 'LEARNING BY HEART', description = 'A digital notebook for systems, language, and social structures.' } = Astro.props;
const currentPath = Astro.url.pathname;
const nav = [{ label:'NOTEBOOK', href:'/' }, { label:'INDEX', href:'/archive/' }, { label:'ESSAYS', href:'/posts/' }, { label:'ABOUT', href:'/terminal/' }];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="article" /><title>{title} — LEARNING BY HEART</title></head><body>
<div class="site-shell"><header class="site-header"><div class="brand-row"><a class="brand" href={import.meta.env.BASE_URL}>LEARNING BY HEART</a><a class="search-link" href={`${import.meta.env.BASE_URL}search/`} aria-label="Search essays">⌕</a></div><nav class="nav" aria-label="Primary navigation">{nav.map((item) => <a href={`${import.meta.env.BASE_URL}${item.href === '/' ? '' : item.href.slice(1)}`} aria-current={currentPath === `${import.meta.env.BASE_URL}${item.href === '/' ? '' : item.href.slice(1)}` ? 'page' : undefined}>{item.label}</a>)}<span class="status" style="margin-left:auto;padding:10px 12px;">NOTEBOOK: ACTIVE</span></nav></header><main><slot /></main><footer class="footer">LIVING NOTEBOOK // NO TRACKING // BUILT FOR LONG-FORM ATTENTION</footer></div>
</body></html>
