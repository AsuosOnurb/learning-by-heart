---
import '../styles/global.css';
const { title = 'SYNTAX ERROR', description = 'A digital notebook for systems, language, and social structures.' } = Astro.props;
const currentPath = Astro.url.pathname;
const nav = [{ label:'LOG', href:'/' }, { label:'ARCHIVE', href:'/archive/' }, { label:'TRANSMISSIONS', href:'/posts/' }, { label:'TERMINAL', href:'/terminal/' }];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="article" /><title>{title} — SYNTAX ERROR</title></head><body>
<div class="site-shell"><header class="site-header"><div class="brand-row"><a class="brand" href="/">SYNTAX ERROR</a><a class="search-link" href="/search/" aria-label="Search transmissions">⌕</a></div><nav class="nav" aria-label="Primary navigation">{nav.map((item) => <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}<span class="status" style="margin-left:auto;padding:10px 12px;">MODE: GHOST</span></nav></header><main><slot /></main><footer class="footer">STATIC NOTEBOOK // NO TRACKING // BUILT FOR LONG-FORM ATTENTION</footer></div>
</body></html>
