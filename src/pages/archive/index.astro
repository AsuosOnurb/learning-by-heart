---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import TransmissionCard from '../../components/TransmissionCard.astro';
const posts=(await getCollection('transmissions',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()); const allTags=[...new Set(posts.flatMap((post)=>post.data.tags))].sort();
---
<BaseLayout title="INDEX"><section class="page-heading"><p class="eyebrow">/ NOTEBOOK INDEX</p><h1>ALL NOTES</h1><p>Ten notes per page. Six subject channels. No urgency attached.</p></section><div class="filter-bar" aria-label="Filter notes by subject"><button type="button" data-category="all" aria-pressed="true">ALL</button>{['philosophy','metaphysics','politics','language','society','code'].map((category)=><button type="button" data-category={category} aria-pressed="false">{category.toUpperCase()}</button>)}</div><div class="filter-bar" aria-label="Filter notes by tag"><button type="button" data-tag="all" aria-pressed="true">ALL FILES</button>{allTags.map((tag)=><button type="button" data-tag={tag} aria-pressed="false">[{tag.toUpperCase()}]</button>)}</div><p id="active-filter" class="eyebrow">SHOWING: ALL NOTES</p><section id="archive-results" class="archive-grid">{posts.map((post)=><div data-categories={post.data.categories.join(' ')} data-tags={post.data.tags.join(' ')}><TransmissionCard post={post}/></div>)}</section><p id="filter-empty" class="filter-empty" hidden>NO NOTES MATCH THIS FILTER.</p><div class="pagination" style="margin-top:18px;"><span>PAGE 01 / 01</span><span>NOTEBOOK END</span></div></BaseLayout>
<script>const params=new URLSearchParams(location.search);let selectedCategory=params.get('category')||'all';let selectedTag=params.get('tag')||'all';const categoryButtons=[...document.querySelectorAll('[data-category]')];const tagButtons=[...document.querySelectorAll('[data-tag]')];const archiveCards=[...document.querySelectorAll('[data-categories]')];const empty=document.querySelector('#filter-empty');const active=document.querySelector('#active-filter');function applyFilters(){categoryButtons.forEach((button)=>button.setAttribute('aria-pressed',String(button.dataset.category===selectedCategory)));tagButtons.forEach((button)=>button.setAttribute('aria-pressed',String(button.dataset.tag===selectedTag)));let visible=0;archiveCards.forEach((card)=>{const categoryMatch=selectedCategory==='all'||card.dataset.categories.split(' ').includes(selectedCategory);const tagMatch=selectedTag==='all'||card.dataset.tags.split(' ').includes(selectedTag);card.hidden=!(categoryMatch&&tagMatch);if(categoryMatch&&tagMatch)visible++;});if(empty)empty.hidden=visible>0;if(active)active.textContent=`SHOWING: ${selectedCategory==='all'&&selectedTag==='all'?'ALL NOTES':[selectedCategory,selectedTag].filter((item)=>item!=='all').join(' + ').toUpperCase()}`;}function updateUrl(){const next=new URL(location.href);selectedCategory==='all'?next.searchParams.delete('category'):next.searchParams.set('category',selectedCategory);selectedTag==='all'?next.searchParams.delete('tag'):next.searchParams.set('tag',selectedTag);history.replaceState({},'',next);applyFilters();}categoryButtons.forEach((button)=>button.addEventListener('click',()=>{selectedCategory=button.dataset.category;updateUrl();}));tagButtons.forEach((button)=>button.addEventListener('click',()=>{selectedTag=button.dataset.tag;updateUrl();}));applyFilters();</script>
