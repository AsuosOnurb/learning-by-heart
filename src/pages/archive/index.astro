---
import { getCollection } from 'astro:content';
import PaginatedIndex from '../../components/PaginatedIndex.astro';

const notesPerPage = 10;
const allNotes = (await getCollection('transmissions', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const totalPages = Math.max(1, Math.ceil(allNotes.length / notesPerPage));
const posts = allNotes.slice(0, notesPerPage);
---

<PaginatedIndex posts={posts} currentPage={1} totalPages={totalPages} />
