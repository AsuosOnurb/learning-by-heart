---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import TransmissionCard from '../../components/TransmissionCard.astro';
const posts=(await getCollection('transmissions',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<BaseLayout title="ARCHIVE"><section class="page-heading"><p class="eyebrow">/ ARCHIVE DIRECTORY</p><h1>ALL TRANSMISSIONS</h1><p>Ten transmissions per page. Six subject channels. No urgency attached.</p></section><div class="filter-bar" aria-label="Filter transmissions"><button type="button" data-filter="all" aria-pressed="true">ALL</button>{['philosophy','metaphysics','politics','language','society','code'].map((category)=><button type="button" data-filter={category} aria-pressed="false">{category.toUpperCase()}</button>)}</div><section id="archive-results" class="archive-grid">{posts.map((post)=><div data-categories={post.data.categories.join(' ')}><TransmissionCard post={post}/></div>)}</section><p id="filter-empty" class="filter-empty" hidden>NO TRANSMISSIONS MATCH THIS CHANNEL.</p><div class="pagination" style="margin-top:18px;"><span>PAGE 01 / 01</span><span>ARCHIVE END</span></div></BaseLayout>
<script>const filterButtons=[...document.querySelectorAll('[data-filter]')];const archiveCards=[...document.querySelectorAll('[data-categories]')];const empty=document.querySelector('#filter-empty');filterButtons.forEach((button)=>button.addEventListener('click',()=>{const filter=button.dataset.filter;filterButtons.forEach((item)=>item.setAttribute('aria-pressed',String(item===button)));let visible=0;archiveCards.forEach((card)=>{const matches=filter==='all'||card.dataset.categories.split(' ').includes(filter);card.hidden=!matches;if(matches)visible++;});if(empty)empty.hidden=visible>0;}));</script>
