---
import { getCollection } from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro'; import Sidebar from '../components/Sidebar.astro'; import TransmissionCard from '../components/TransmissionCard.astro';
const posts = (await getCollection('transmissions',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,5);
---
<BaseLayout><div class="directory"><Sidebar /><section class="feed" aria-labelledby="latest-heading"><div class="section-heading"><h1 id="latest-heading">LATEST TRANSMISSIONS</h1><p>INDEX: 001—005</p></div>{posts.map((post)=><TransmissionCard post={post}/>)}<div class="section-heading"><p>CONTINUE INTO THE ARCHIVE</p><a href="/archive/">/ OPEN_ARCHIVE</a></div></section></div></BaseLayout>
