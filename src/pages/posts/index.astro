---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro';
const posts=(await getCollection('transmissions',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<BaseLayout title="TRANSMISSIONS"><section class="page-heading"><p class="eyebrow">/ TRANSMISSION INDEX</p><h1>THE LOG</h1><p>Long-form transmissions, filed by date and subject.</p></section><div class="archive-grid">{posts.map((post)=><a href={`${import.meta.env.BASE_URL}posts/${post.slug}/`}>{post.data.title}</a>)}</div></BaseLayout>
